@article{Puckorius1991,
  author  = {Puckorius, P. R. and Brooke, J. M.},
  title   = {A New Practical Index for Calcium Carbonate Scale Prediction in Cooling Tower Systems},
  journal = {Corrosion},
  year    = {1991},
  volume  = {47},
  number  = {4},
  pages   = {280--284},
  doi     = {10.5006/1.3585256},
  url     = {https://doi.org/10.5006/1.3585256},
  note    = {verified={metadata+abstract}. Abstract explicitly states existing calcium carbonate scaling indices (incl. Langelier and Ryznar) are \textbf{ineffective and inaccurate in concentrated cooling tower water at pH above 7.5}, and proposes the Practical (Puckorius) index. IMPORTANT for A19: this is direct published support for the claim that a single saturation index is NOT a universal CoC ceiling --- it is a scaling-risk indicator whose validity is regime-limited. Cited 62 times.}
}

