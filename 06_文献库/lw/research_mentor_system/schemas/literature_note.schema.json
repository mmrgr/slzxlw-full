{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "literature_note.schema.json",
  "title": "文献笔记 Schema",
  "description": "用于记录和评估单篇研究文献的结构化笔记，支持研究空白识别与文献综述构建。",
  "type": "object",
  "properties": {
    "paper_id": {
      "description": "文献唯一标识",
      "type": "string"
    },
    "title": {
      "description": "论文标题",
      "type": "string"
    },
    "authors": {
      "description": "作者列表",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journal": {
      "description": "发表期刊",
      "type": "string"
    },
    "year": {
      "description": "发表年份",
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "doi": {
      "description": "数字对象标识符（DOI）",
      "type": "string"
    },
    "research_question": {
      "description": "研究问题",
      "type": "string"
    },
    "methodology": {
      "description": "研究方法",
      "type": "string"
    },
    "key_findings": {
      "description": "关键发现列表",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "description": "局限性列表",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevance_to_research": {
      "description": "与本研究的关联度及研究空白类型",
      "type": "object",
      "properties": {
        "gap_type": {
          "description": "研究空白类型",
          "type": "string",
          "enum": [
            "unanswered_question",
            "method_limitation",
            "contradiction",
            "new_phenomenon",
            "no_gap"
          ]
        }
      },
      "required": [
        "gap_type"
      ],
      "additionalProperties": true
    },
    "notes": {
      "description": "其他笔记",
      "type": "string"
    },
    "read_count": {
      "description": "阅读次数",
      "type": "integer",
      "minimum": 0
    },
    "quality_score": {
      "description": "质量评分（1-5分，5分为最高）",
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "required": [
    "paper_id",
    "title",
    "authors",
    "journal",
    "year",
    "doi",
    "research_question",
    "methodology",
    "key_findings",
    "limitations",
    "relevance_to_research",
    "notes",
    "read_count",
    "quality_score"
  ],
  "additionalProperties": false
}
